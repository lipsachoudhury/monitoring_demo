# Copy to .env and fill in real values. Never commit .env.
# Generate a strong SECRET_KEY, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Login username (no default; must be set explicitly)
ADMIN_USERNAME=
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=
